{
  "name": "japanese-house-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:mirror": "node scripts/verify-mirror-math.mjs && node scripts/verify-mirror-source.mjs && node scripts/verify-senmen-mirror.mjs",
    "bake:senmen-basin": "node --experimental-strip-types scripts/bake-senmen-basin.mjs",
    "test:basin": "node --experimental-strip-types scripts/verify-senmen-basin.mjs",
    "test:tub": "node --experimental-strip-types scripts/verify-tub-wet.mjs",
    "test:toilet": "node --experimental-strip-types scripts/verify-sit-toilet.mjs && node --experimental-strip-types scripts/verify-amage-toilet.mjs",
    "bake:house": "node --experimental-strip-types scripts/bake-house.mjs",
    "test:house": "node --experimental-strip-types scripts/verify-house-glb.mjs",
    "bake:genkan-door": "node --experimental-strip-types scripts/bake-genkan-door.mjs",
    "test:genkan-door": "node --experimental-strip-types scripts/verify-genkan-door.mjs",
    "bake:ub-bath": "node --experimental-strip-types scripts/bake-ub-bath.mjs",
    "test:ub-bath": "node --experimental-strip-types scripts/verify-ub-bath.mjs",
    "bake:kitchen": "node --experimental-strip-types scripts/bake-kitchen.mjs",
    "test:kitchen": "node --experimental-strip-types scripts/verify-kitchen.mjs",
    "bake:senmen-piara": "node --experimental-strip-types scripts/bake-senmen-piara.mjs",
    "test:senmen-piara": "node --experimental-strip-types scripts/verify-senmen-piara.mjs",
    "bake:amage-toilet": "node --experimental-strip-types scripts/bake-amage-toilet.mjs",
    "test:amage-toilet": "node --experimental-strip-types scripts/verify-amage-toilet.mjs",
    "bake:dokodemo-wash": "node --experimental-strip-types scripts/bake-dokodemo-wash.mjs",
    "test:dokodemo-wash": "node --experimental-strip-types scripts/verify-dokodemo-wash.mjs",
    "bake:standard-label-doors": "node --experimental-strip-types scripts/bake-standard-label-doors.mjs",
    "test:standard-label-doors": "node --experimental-strip-types scripts/verify-standard-label-doors.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
